# Optional shared secret. When set, every endpoint except /, /health, and /docs
# requires X-API-Key header or ?key= query parameter.
API_KEY=

# Fixed-window rate limit per client IP per minute (0 disables rate limiting).
RATE_LIMIT_PER_MIN=60

# In-memory response cache TTL in seconds (0 disables caching).
CACHE_TTL=300

# Upstream YouTube request timeout in seconds.
REQUEST_TIMEOUT=45

# HTTP listen port (Railway injects PORT automatically).
PORT=8000

# Optional HTTP/HTTPS/SOCKS5 egress proxy (e.g. http://user:pass@proxy.example.com:8080).
YT_PROXY=
